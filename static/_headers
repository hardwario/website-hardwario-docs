# Cloudflare Workers Static Assets — netlify-compatible header rules.
# https://developers.cloudflare.com/workers/static-assets/headers/
# This file lives in static/ and Docusaurus copies it to build/_headers.
# More-specific rules first; security defaults catch everything else.

# Docusaurus content-hashes everything under /assets/ (e.g. styles.<hash>.css,
# runtime~main.<hash>.js) — safe to cache forever. Without this rule Cloudflare
# serves them max-age=0 and they revalidate on every request.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons / logos in /img are not hashed — moderate TTL keeps a swap path.
/img/*
  Cache-Control: public, max-age=2592000

# Interactive board-viewer exports are support artifacts, not standalone
# documentation pages; keep them accessible without putting them in search.
# They are self-contained KiCad InteractiveHtmlBom pages built on inline scripts
# and onclick handlers, so the site's CSP (below) does not apply to them.
/download/ibom/*
  X-Robots-Tag: noindex
  ! Content-Security-Policy-Report-Only
  ! Reporting-Endpoints

/cs/download/ibom/*
  X-Robots-Tag: noindex
  ! Content-Security-Policy-Report-Only
  ! Reporting-Endpoints

# Site search is useful to visitors but not a useful landing page for crawlers.
/search*
  X-Robots-Tag: noindex

# Security response headers for every route (HTML + assets).
# Content-Security-Policy-Report-Only (from 2026-11-02): violations are reported
# to /csp-report, which the Worker logs to Workers Logs (filter kind = csp-report);
# nothing is blocked. After two weeks of reports, decide on enforcing.
# - script-src: no 'unsafe-inline'. The hashes are Docusaurus' inline scripts: the
#   colour-mode bootstrap on every page and the base-URL banner on the EN and CS
#   homepages. A Docusaurus upgrade can change them: run `npm run verify:csp`
#   after `npm run build`, and put the hashes it lists here.
# - style-src keeps 'unsafe-inline': React style attributes, ideal-image
#   placeholders, Prism and Mermaid all write inline styles.
# - connect-src: the chat widget's backend (docs-chatbot-beta.vercel.app), its
#   rating form (docs.google.com) and the ThingsBoard connector (app.hardwario.cloud).
# - frame-src: YouTube (youtube-nocookie, only after the visitor presses play) and
#   the ThingsBoard demo dashboard (app.hardwario.cloud, also click-to-load).
# HSTS is intentionally max-age only (no includeSubDomains/preload): this is a
# subdomain of hardwario.com and preload is effectively irreversible — keep it
# in step with the apex's deliberately conservative HSTS.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Reporting-Endpoints: csp-endpoint="/csp-report"
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'sha256-VSjX2aDQTt9NLoldfwitmTdwi/Q1Ul2H+D/aNhI0EuM=' 'sha256-0MUyFJhUwQbJbxdRddDw1q7CMNQ//leUWFbuI6XcmZo=' 'sha256-/KdKZA1Dc/wxVzoVs+p7ovq4sZz0sO9WUYUsYJE7e4M='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://docs-chatbot-beta.vercel.app https://docs.google.com https://app.hardwario.cloud; frame-src https://www.youtube-nocookie.com https://app.hardwario.cloud; report-uri /csp-report; report-to csp-endpoint
