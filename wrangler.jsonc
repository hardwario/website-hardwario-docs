{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-hardwario-docs",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Chatbot backend. Lives in this project rather than one of its own: the
  // docs already deploy as a Worker with static assets, so /api/chat is
  // same-origin — no second project, no zone route, and no CORS allowlist.
  "main": "./worker/index.mjs",
  "assets": {
    "directory": "build",
    "not_found_handling": "404-page",
    // The Worker runs for /api/* only. Documentation pages are served straight
    // from the assets and never execute it, so a fault in the chatbot cannot
    // take the docs down.
    "run_worker_first": ["/api/*"]
  },
  // Embeds the incoming question with @cf/baai/bge-m3 — the same weights the
  // index was built with in scripts/chatbot/build_index.py. They must match.
  "ai": { "binding": "AI" },
  // Rebuilt monthly as a new version, then switched here. See
  // scripts/chatbot/README.md.
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "hardwario-v1" }]
}
