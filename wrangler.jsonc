{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-hardwario-docs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The site is served only on its custom domain. Keep the <name>.hardwario.workers.dev
  // route off so the whole site is not reachable (and indexable) on a second host.
  // Version URLs stay on explicitly: the "Deploy non-production branches" Workers Builds
  // trigger runs `wrangler versions upload` for pull-request previews, and Cloudflare
  // derives their default from workers_dev when the setting is absent.
  "workers_dev": false,
  "preview_urls": true,
  // The Worker only answers POST /csp-report (the CSP report collector, see
  // worker/csp-report.mjs); every other request is served from the assets
  // without running it. Keep this free of ai/vectorize bindings: worker/index.mjs
  // (the dormant chatbot) is not the entry and its bindings would need a
  // Vectorize index on the account, whose absence fails the whole deploy.
  "main": "./worker/csp-report.mjs",
  // Workers Logs: the collector's report lines land here (filter kind = csp-report).
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "build",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/csp-report"]
  }
}
